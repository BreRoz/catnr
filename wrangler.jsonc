{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catnr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily retention clean-up (04:15 UTC): wipes finished question photos and old retry records.
  "triggers": { "crons": ["15 4 * * *"] },
  // Production custom domain. workers_dev stays on so the old catnr.bre999.workers.dev address keeps working.
  "routes": [{ "pattern": "catnr.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catnr-db",
      "database_id": "2833176c-ce03-4087-b118-a9879a6ad2fc",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Which deployment this is. /_ops/status shows it and scripts/verify-deploy.mjs checks it.
    "ENVIRONMENT": "production",
    // Google sign-in. The OAuth client ID is public (it is shown on the sign-in page). Empty = deployed worker refuses everyone (503).
    // SESSION_SECRET is NOT here: it is a Worker secret (npx wrangler secret put SESSION_SECRET).
    "GOOGLE_CLIENT_ID": "314630259223-jc73fe74ihcpe61r709rb7o2egdupa08.apps.googleusercontent.com"
  },
  // Staging: a separate worker with its own empty database and no AI key, so experiments never touch
  // real records or cost real money. It stays closed (503) until its GOOGLE_CLIENT_ID is filled in and
  // SESSION_SECRET is set (npx wrangler secret put SESSION_SECRET --env staging). Build and deploy it with `npm run deploy:staging`.
  "env": {
    // Browser tests (tests/e2e): a throwaway local-only worker. No sign-in, no real AI key, its own local database.
    // It is never deployed; the ENVIRONMENT value is what allows the fake AI provider URL.
    "e2e": {
      "name": "catnr-e2e",
      "triggers": { "crons": [] },
      "d1_databases": [
        { "binding": "DB", "database_name": "catnr-e2e-db", "database_id": "00000000-0000-4000-8000-000000000e2e", "migrations_dir": "drizzle" }
      ],
      "vars": { "ENVIRONMENT": "e2e", "GOOGLE_CLIENT_ID": "" }
    },
    // Browser test of the sign-in wall: sign-in is configured, so every request without a session must be refused.
    "e2e-locked": {
      "name": "catnr-e2e-locked",
      "triggers": { "crons": [] },
      "d1_databases": [
        { "binding": "DB", "database_name": "catnr-e2e-locked-db", "database_id": "00000000-0000-4000-8000-0000000e2e10", "migrations_dir": "drizzle" }
      ],
      "vars": { "ENVIRONMENT": "e2e-locked", "GOOGLE_CLIENT_ID": "e2e-locked.apps.googleusercontent.com" }
    },
    "staging": {
      "name": "catnr-staging",
      "triggers": { "crons": [] },
      "observability": { "enabled": true },
      "d1_databases": [
        { "binding": "DB", "database_name": "catnr-staging-db", "database_id": "7b9a4912-c5bc-4b3a-8351-058436838640", "migrations_dir": "drizzle" }
      ],
      "vars": { "ENVIRONMENT": "staging", "GOOGLE_CLIENT_ID": "" }
    }
  }
}
